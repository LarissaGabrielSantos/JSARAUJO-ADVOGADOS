rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /audiencias/{audienciaId} {
      allow read: if isOwner();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && validRequiredFields(request.resource.data);
      allow update: if isOwner()
                    && request.resource.data.userId == request.auth.uid
                    && validRequiredFields(request.resource.data);
      allow delete: if isOwner();
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner() {
      return isAuthenticated()
             && resource.data.userId == request.auth.uid;
    }

    function validRequiredFields(data) {
      return data.keys().hasAll([
        'processo',
        'parte',
        'status',
        'data',
        'horario',
        'userId'
      ])
      && data.userId is string
      && data.processo is string
      && data.parte is string
      && data.status in ['a-fazer', 'agendada', 'realizada', 'cancelada']
      && data.data is string
      && data.horario is string;
    }
  }
}
